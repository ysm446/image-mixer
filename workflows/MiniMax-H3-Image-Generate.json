{
  "1": {
    "inputs": { "unet_name": "minimax_h3_image_pruned_int8_convrot.safetensors", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "MiniMax H3 Image Diffusion Model" }
  },
  "2": {
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Qwen3-VL 32B MiniMax H3 Text Encoder" }
  },
  "3": {
    "inputs": { "vae_name": "minimax_h3_image_vae_fp16.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "MiniMax H3 Image VAE" }
  },
  "4": {
    "inputs": {
      "prompt": "A photo of a cat.",
      "width": 2048,
      "height": 2048,
      "clip": ["2", 0],
      "vae": ["3", 0]
    },
    "class_type": "MiniMaxH3ImageConditioning",
    "_meta": { "title": "MiniMax H3 Image Input Prompt" }
  },
  "5": {
    "inputs": { "conditioning": ["4", 0] },
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative (Zero Out)" }
  },
  "6": {
    "inputs": {
      "seed": 42,
      "steps": 6,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["4", 1]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Kサンプラー" }
  },
  "7": {
    "inputs": { "samples": ["6", 0], "vae": ["3", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAEデコード" }
  },
  "8": {
    "inputs": { "images": ["7", 0] },
    "class_type": "PreviewImage",
    "_meta": { "title": "画像プレビュー" }
  }
}
